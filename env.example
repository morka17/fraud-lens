# Copy this file to .env and fill in values for your local environment.
# .env is gitignored — never commit real secrets.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_TRANSACTIONS=txn.events
KAFKA_CONSUMER_GROUP=fraudlens-feature-pipeline

# --- Redis (online feature store) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_FEATURE_TTL_SECONDS=86400

# --- Offline store (local Parquet by default; swap for Snowflake in prod) ---
OFFLINE_STORE_PATH=./data/offline_store
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# --- Spark ---
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./streaming/checkpoints

# --- Model ---
MODEL_PATH=./training/model.pkl
FRAUD_SCORE_THRESHOLD=0.75

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
